		"description": "Doc template"
	},
	
	"Itemize": {
		"prefix": "item",
		"body": [ 
			"\\begin{itemize}",
			"    \\item",
			"\\end{itemize}"
		],
		"description": "Itemize order"


	},
	"Code format": {
		"prefix": "code",
		"body": [ 
			"\\codeLine{lang}{}"
		],
		"description": "Code format"


	},
	"Code box Lslist": {
		"prefix": "block",
		"body": [ 
			"\\begin{codeBlock}{lang}", 
			"",
			"\\end{codeBlock}"   
		],
		"description": "Code box format"

	},
	"Box listing with no lang support": {
		"prefix": "ls",
		"body": [ 
			"\\begin{lstlisting}",
			"    ",
			"\\end{lstlisting}"

		],
		"description": "Listing box format"

	},
	"Enumerate": {
		"prefix": "enum",
		"body": [ 
			"\\begin{enumerate}",
			"    \\item ",
			"\\end{enumerate}"
		],
		"description": "Enumerate order"

	},
	"Center": {
